<Syntax>

    <Term name="foo">
        <Phrase>
            <Token ident="foo" cardinality="one"/>
        </Phrase>
    </Term>

    <Term name="fooAndBar">
        <Phrase>
            <Token ident="foo"/>
        </Phrase>
        <Phrase>
            <Token ident="bar"/>
        </Phrase>
    </Term>

    <Term name="fooOrBar">
        <Phrase>
            <Token ident="foo"/>
            <Token ident="bar"/>
        </Phrase>
    </Term>

    <Term name="fooOptionalBar">
        <Phrase>
            <Token ident="foo"/>
        </Phrase>
        <Phrase>
            <Token ident="bar" cardinality="optional"/>
        </Phrase>
    </Term>
    
    <Term name="atLeastOneFoo">
        <Phrase>
            <Token ident="foo" cardinality="atLeastOne" separator=","/>
        </Phrase>
    </Term>

    <Term name="fooManyBar">
        <Phrase>
            <Token ident="foo"/>
        </Phrase>
        <Phrase>
            <Token ident="bar" cardinality="many" separator=","/>
        </Phrase>
    </Term>

    <Term name="fooTerm">
        <Phrase>
            <Token ident="$foo"/>
        </Phrase>
    </Term>

    <Term name="fooIntBar">
        <Phrase>
            <Token ident="foo"/>
        </Phrase>
        <Phrase>
            <Token ident="!int"/>
        </Phrase>
        <Phrase>
            <Token ident="bar"/>
        </Phrase>
    </Term>

    <Term name="fooNoSpaceBar">
        <Phrase spaceAfter="none">
            <Token ident="foo"/>
        </Phrase>
        <Phrase>
            <Token ident="bar"/>
        </Phrase>
    </Term>
    
    <Term name="fooSpaceBar">
        <Phrase spaceAfter="required">
            <Token ident="foo"/>
        </Phrase>
        <Phrase>
            <Token ident="bar"/>
        </Phrase>
    </Term>
    
    <Term name="manyFooBarSeparatorNoSpaceBeforeAfter">
        <Phrase>
            <Token ident="foo" cardinality="many" separator="bar" spaceBeforeSeparator="none" spaceAfterSeparator="none"/>
        </Phrase>
    </Term>

    <Term name="manyFooBarSeparatorSpaceBeforeAfter">
        <Phrase>
            <Token ident="foo" cardinality="many" separator="bar" spaceBeforeSeparator="required" spaceAfterSeparator="required"/>
        </Phrase>
    </Term>

    <Term name="manyFooBarSeparatorNoSpaceBeforeSpaceAfter">
        <Phrase>
            <Token ident="foo" cardinality="many" separator="bar" spaceBeforeSeparator="none" spaceAfterSeparator="required"/>
        </Phrase>
    </Term>

    <Term name="manyFooBarSeparatorSpaceBeforeNoSpaceAfter">
        <Phrase>
            <Token ident="foo" cardinality="many" separator="bar" spaceBeforeSeparator="required" spaceAfterSeparator="none"/>
        </Phrase>
    </Term>

</Syntax>